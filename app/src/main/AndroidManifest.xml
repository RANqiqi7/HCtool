<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 修改订单节点状态前需要生物识别验证（指纹 / 面容） -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!-- 云同步：访问平板 Termux 上的同步服务器 -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- 测试到期提醒：Android 13+ 发通知需运行时申请 POST_NOTIFICATIONS -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 预计结束当天 9:00 精确到分钟的单次提醒（属闹钟类场景，用 SCHEDULE_EXACT_ALARM） -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- 开机后重排提醒闹钟（国产 ROM 可能限制自启，失效时打开 App 也会重排） -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- 拍照（ACTION_IMAGE_CAPTURE）在 Android 11+ 需要声明 intent 可见性 -->
    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
    </queries>

    <!-- 同步地址是内网/Tailscale 隧道的 HTTP，需要允许明文流量（usesCleartextTraffic）；对公网裸奔请换 HTTPS 反代 -->
    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.HCtool"
        android:usesCleartextTraffic="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.HCtool"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 相机拍照写入的临时文件通过 FileProvider 授权给系统相机 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- 测试到期提醒：闹钟到点与开机重排都经这个接收器回到 TestReminders 重算补发 -->
        <receiver
            android:name="com.example.hctool.ui.order.TestReminderReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.example.hctool.ACTION_TEST_DUE" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>